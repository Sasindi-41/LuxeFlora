<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F8F8"
    tools:context=".fragment.ProductDetailsFragment">

    <androidx.core.widget.NestedScrollView
        android:layout_above="@+id/product_details_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            app:cardCornerRadius="20dp"
            app:cardElevation="3dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="300dp">

                    <androidx.viewpager2.widget.ViewPager2
                        android:id="@+id/product_image_slider"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageView
                        android:id="@+id/product_details_wishlist"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="12dp"
                        android:padding="8dp"
                        android:src="@drawable/favorite_24px"
                        android:background="@drawable/bg_circle_white"
                        android:elevation="6dp" />

                </FrameLayout>

                <com.tbuonomo.viewpagerdotsindicator.DotsIndicator
                    android:id="@+id/dots_indicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    app:dotsColor="#8E977D"
                    app:selectedDotColor="#000000"
                    app:dotsSize="8dp"
                    app:dotsSpacing="4dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/product_details_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Rose Bouquet"
                        android:textStyle="bold"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical">

                        <TextView
                            android:id="@+id/product_details_price"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="LKR 2500.00"
                            android:textStyle="bold"
                            android:textSize="17sp" />

                        <RatingBar
                            android:id="@+id/product_details_rating"
                            style="?android:attr/ratingBarStyleSmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:rating="4.5"
                            android:progressTint="#FFB33F" />
                        <TextView
                            android:id="@+id/product_details_rating_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textStyle="bold"
                            android:text="4.5"
                            android:layout_marginLeft="5dp"/>
                    </LinearLayout>


                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginVertical="12dp"/>

                    <LinearLayout
                        android:id="@+id/product_details_attribute_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Quantity"
                        android:textSize="16sp"
                        android:layout_marginTop="12dp" />


                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_qty_pill"
                        android:gravity="center"
                        android:paddingStart="6dp"
                        android:paddingEnd="6dp">

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/product_details_btn_minus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="-"
                            android:background="@android:color/transparent" />

                        <TextView
                            android:id="@+id/product_details_quantity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="1"
                            android:textSize="16sp"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp" />

                        <androidx.appcompat.widget.AppCompatButton
                            android:id="@+id/product_details_btn_plus"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:text="+"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:padding="2dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Available Quantity :"
                        android:layout_marginTop="8dp"
                        android:textColor="#777777" />

                    <TextView
                        android:id="@+id/product_details_avb_qty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:layout_marginLeft="5dp"/>
                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="#EEEEEE"
                        android:layout_marginVertical="12dp"/>

                    <TextView
                        android:id="@+id/product_details_description_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textStyle="bold"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/product_details_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Colorful mix for a cheerful surprise."
                        android:textSize="14sp"
                        android:layout_marginTop="5dp" />

                </LinearLayout>
                <include
                    android:id="@+id/product_details_top_sell_section"
                    layout="@layout/item_section"
                    android:layout_height="wrap_content"
                    android:layout_width="match_parent"/>

            </LinearLayout>

        </androidx.cardview.widget.CardView>

    </androidx.core.widget.NestedScrollView>

    <LinearLayout
        android:id="@+id/product_details_bottom_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:padding="8dp"

        android:orientation="horizontal">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/product_details_btn_add_cart"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Add to Cart"
            android:textStyle="bold"
            android:textColor="#703346"
            android:layout_marginEnd="12dp"
            android:background="@drawable/rounded_button_light"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/product_details_btn_buy_now"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Buy Now"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:stateListAnimator="@null"
            android:elevation="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:background="@drawable/rounded_button_primary"/>

    </LinearLayout>

</RelativeLayout>