<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="10dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/md_theme_surface">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp">

        <!-- Product Image -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/item_wishlist_image"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CartImageRounded"/>

        <!-- Title + Price -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/item_wishlist_image"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/item_wishlist_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Rose Bouquet"
                android:textStyle="bold"
                android:textSize="15sp"
                android:maxLines="2"
                android:ellipsize="end"/>

            <TextView
                android:id="@+id/item_wishlist_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="LKR 1500.00"
                android:textColor="@color/md_theme_primary"
                android:textStyle="bold"
                android:layout_marginTop="6dp"/>

            <TextView
                android:id="@+id/item_wishlist_stock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="In Stock"
                android:textSize="12sp"
                android:textColor="#4CAF50"
                android:layout_marginTop="4dp"/>


            <com.google.android.material.button.MaterialButton
                android:id="@+id/item_wishlist_move_to_cart"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Add to Cart"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                android:layout_marginTop="2dp"
                app:cornerRadius="18dp"
                android:layout_gravity="end"
                app:backgroundTint="@color/md_theme_primary"
                android:textColor="@android:color/white"/>

        </LinearLayout>

        <ImageView
            android:id="@+id/item_wishlist_remove"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:background="@drawable/bg_circle_white"
            android:src="@drawable/favorite_fill_24px"
            android:padding="6dp"/>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>