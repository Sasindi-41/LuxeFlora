<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    android:paddingEnd="10dp"
    app:cardBackgroundColor="@color/md_theme_background_fragment"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="6dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/item_cart_image"
            android:layout_width="85dp"
            android:layout_height="85dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/CartImageRounded"/>


        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="10dp"
            android:layout_gravity="center_vertical">

            <TextView
                android:id="@+id/item_cart_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Product Title"
                android:layout_marginStart="8dp"
                android:textStyle="bold"
                android:layout_marginTop="15dp"
                android:textSize="14sp"
                android:ellipsize="end"
                android:maxLines="2"/>


            <TextView
                android:id="@+id/item_cart_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginStart="8dp"
                android:text="LKR 1500.00"
                android:textColor="@color/md_theme_primary"
                android:textSize="15sp"
                android:textStyle="bold" />


        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:orientation="horizontal"
            android:layout_gravity="bottom|end"
            android:paddingEnd="10dp"
            android:background="@drawable/bg_qty_pill"

            >

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/item_cart_btn_minus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:text="-"
                android:background="@android:color/transparent"/>
            <TextView
                android:id="@+id/item_cart_quantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textAlignment="center"
                android:text="1"
                android:textSize="16sp"/>
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/item_cart_btn_plus"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:text="+"
                android:background="@android:color/transparent"/>

        </LinearLayout>


    </LinearLayout>
    <ImageView
        android:id="@+id/item_cart_remove"
        android:layout_width="33dp"
        android:layout_height="33dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_gravity="right"
       android:layout_marginLeft="10dp"
        android:padding="2dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/close_small_24px" />
</com.google.android.material.card.MaterialCardView>